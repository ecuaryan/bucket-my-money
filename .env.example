# Copy this file to .env.local and fill in real values for local dev.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
#
# Local Supabase: npm run db:start && source scripts/env-local.sh
# Hosted project: use Dashboard → Settings → API for URL + anon key.

# Supabase (client-safe)
VITE_SUPABASE_URL=
# Preferred on hosted projects (Settings → API Keys → Publishable and secret):
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy local Docker / older hosted projects (still supported as fallback):
VITE_SUPABASE_ANON_KEY=

# Login buttons (client-safe): google (default) | google,apple. Enable each in
# Supabase → Authentication → Sign In / Providers first; Apple needs a paid
# Apple Developer membership.
VITE_OAUTH_PROVIDERS=google

# Teller Connect (client-safe — Connect runs in the browser)
VITE_TELLER_APPLICATION_ID=
# sandbox | development | production — must match supabase/functions/.env
VITE_TELLER_ENVIRONMENT=sandbox

# --- Edge Function only ---
# NEVER prefix with VITE_. For local dev, put these in
# `supabase/functions/.env` (gitignored). For deployed functions, set
# via `supabase secrets set` so they're available at runtime.
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=production
TELLER_CERTIFICATE=
TELLER_PRIVATE_KEY=
TELLER_SIGNING_SECRET=

# Scheduled balance refresh (teller-scheduled-refresh). Shared secret the
# pg_cron sweep sends as X-Cron-Secret; the function rejects calls without
# it, so the sweep stays inert until this is set. Also store the same value
# plus the function URL in Supabase Vault (see README § Production deploy):
#   scheduled_refresh_secret = <this value>
#   scheduled_refresh_url     = https://<project-ref>.supabase.co/functions/v1/teller-scheduled-refresh
SCHEDULED_REFRESH_SECRET=
# Optional tuning (defaults shown): staleness threshold and batch size.
# SCHEDULED_REFRESH_CADENCE_HOURS=6
# SCHEDULED_REFRESH_BATCH=50
