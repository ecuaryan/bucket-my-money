---
import Base from '../layouts/Base.astro'
import { SIGN_IN_URL } from '../lib/links'

interface Section {
  title: string
  items: string[]
}
interface Props {
  title: string
  description: string
  heading: string
  updated: string
  sections: Section[]
  contactLabel: string
}

const { title, description, heading, updated, sections, contactLabel } = Astro.props
// Assembled in the browser so the address never appears in the page HTML.
const contactUser = 'privacy'
const contactHost = 'bucketmymoney.com'
---

<Base title={title} description={description}>
  <header class="border-b border-zinc-900">
    <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-3">
      <a href="/" class="flex items-center gap-2.5 font-semibold text-white">
        <img src="/app-assets/icons/icon-96.png" alt="Bucket My Money" width="32" height="32" class="rounded-lg" />
        <span>Bucket My Money</span>
      </a>
      <a href={SIGN_IN_URL} class="rounded-lg px-3 py-2 text-sm text-zinc-300 hover:text-white">Sign in</a>
    </nav>
  </header>

  <main class="mx-auto max-w-3xl px-5 py-14">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{heading}</h1>
    <p class="mt-2 text-sm text-zinc-500">Last updated {updated}</p>

    {
      sections.map((s) => (
        <section class="mt-10">
          <h2 class="text-xl font-semibold text-white">{s.title}</h2>
          <ul class="mt-3 space-y-3 leading-relaxed text-zinc-400">
            {s.items.map((item) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-white">Contact</h2>
      <p class="mt-3 text-zinc-400">
        {contactLabel}{' '}
        <a
          id="contact-link"
          class="text-emerald-400 hover:underline"
          href="/privacy/"
          data-user={contactUser}
          data-host={contactHost}>{contactUser} at {contactHost}</a
        >
      </p>
      <script is:inline src="/contact.js" defer></script>
    </section>
  </main>

  <footer class="border-t border-zinc-900">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-8 text-sm text-zinc-500">
      <p>© {new Date().getFullYear()} Bucket My Money</p>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-zinc-300">Privacy</a>
        <a href="/terms" class="hover:text-zinc-300">Terms</a>
        <a href="/" class="hover:text-zinc-300">Home</a>
      </div>
    </div>
  </footer>
</Base>
