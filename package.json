{
  "name": "bucket-my-money",
  "private": true,
  "version": "1.12.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "node scripts/dev-phone.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:db",
    "check": "npm run lint && npm test && npm run build",
    "check:full": "npm run lint && npm run test:all && npm run build",
    "db:start": "supabase start",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/db-seed.mjs",
    "db:reset:seed": "supabase db reset && node scripts/db-seed.mjs",
    "pwa:screenshots": "playwright test --config playwright.pwa-screenshots.config.ts",
    "pwa:gifs": "npm run db:reset:seed -- pwa-gifs && playwright test --config playwright.pwa-gifs.config.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "env:local": "node scripts/supabase-env.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@supabase/supabase-js": "^2.106.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "supabase": "^2.105.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
